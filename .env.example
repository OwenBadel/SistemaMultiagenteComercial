# Configuracion de Base de Datos en la Nube (Supabase) y Puente Botpress
# Copia este archivo como .env y completa las credenciales de tu proyecto Supabase.

# --- BASE DE DATOS EN LA NUBE (SUPABASE) ---
# Encuentalos en Supabase -> Project Settings -> API
# SUPABASE_URL: Project URL (ej. https://xxxxxxxxxxxx.supabase.co)
# SUPABASE_KEY: service_role key (recomendada para backend) o anon key
# Si se dejan vacios, el sistema usa SQLite local automaticamente (data/entorno_local.db).
SUPABASE_URL=
SUPABASE_KEY=

# Identificador del negocio/independiente en la tabla 'negocios' de Supabase
# Ejemplos precargados en sql/supabase_schema_y_seed.sql: tech_freelance | estudio_fotografia
NEGOCIO_ID=tech_freelance
SQLITE_DB_PATH=data/entorno_local.db

# --- PUENTE BOTPRESS Y NOTIFICACION AL DUENO ---
# Opcional: si lo dejas vacio, Botpress puede consultar sin cabecera de autenticacion
BOTPRESS_API_KEY=

# Opcional: sobrescribe el telefono del dueno guardado en Supabase (formato internacional sin +)
OWNER_WHATSAPP_NUMBER=

# --- SERVIDOR HTTP ---
HOST=0.0.0.0
PORT=8000
