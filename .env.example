# Configuracion opcional para la API puente con Botpress
# Copia este archivo como .env para personalizar puerto, API Key o numero del dueno.

# Opcional: si lo dejas vacio, Botpress puede consultar sin cabecera de autenticacion (ideal para pruebas)
BOTPRESS_API_KEY=

# Numero de WhatsApp personal del dueno corporativo (formato internacional sin +, ej. 573001234567)
# Botpress usa este numero para enviarle la alerta cuando un chat entra en pausa Human-in-the-Loop
OWNER_WHATSAPP_NUMBER=

# Servidor Web / API
HOST=0.0.0.0
PORT=8000
