# Configuracion de Base de Datos en la Nube (Supabase), Google Calendar y Botpress
# Copia este archivo como .env y completa las credenciales.

# --- BASE DE DATOS EN LA NUBE (SUPABASE) ---
# En Supabase -> Project Settings -> Data API (URL) y API Keys (Secret key)
SUPABASE_URL=
SUPABASE_KEY=

# Identificador del negocio/independiente en la tabla 'negocios' de Supabase
NEGOCIO_ID=tech_freelance
SQLITE_DB_PATH=data/entorno_local.db

# --- GOOGLE CALENDAR API v3 (AGENDA REAL) ---
# Correo o ID del calendario compartido con la Service Account (ej. tunegocio@gmail.com)
GOOGLE_CALENDAR_ID=
# Ruta al archivo JSON de Service Account (ej. google_service_account.json) o el JSON completo en una linea
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_TIMEZONE=America/Bogota

# --- PUENTE BOTPRESS Y NOTIFICACION AL DUENO ---
BOTPRESS_API_KEY=
OWNER_WHATSAPP_NUMBER=

# --- SERVIDOR HTTP ---
HOST=0.0.0.0
PORT=8000
