# Configuracion de integracion con Meta Platforms (WhatsApp, Instagram, Messenger)
# Copia este archivo como .env y completa las credenciales de Meta for Developers.

META_VERIFY_TOKEN=sma_comercial_verify_2026
META_APP_SECRET=
META_API_VERSION=v21.0

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
ADMIN_WHATSAPP_NUMBER=

# Facebook Messenger (Page Access Token)
MESSENGER_PAGE_ACCESS_TOKEN=

# Instagram Graph API (Instagram Messaging)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# Servidor Web / Webhook
HOST=0.0.0.0
PORT=8000

