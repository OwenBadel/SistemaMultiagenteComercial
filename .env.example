# Configuracion de Base de Datos en la Nube (Supabase), Google Calendar, Botpress y Ollama (Meta Llama Local)
# Copia este archivo como .env y completa las credenciales.

# --- BASE DE DATOS EN LA NUBE (SUPABASE) ---
# En Supabase -> Project Settings -> Data API (URL) y API Keys (Secret key)
SUPABASE_URL=
SUPABASE_KEY=

# Identificador del negocio/independiente en la tabla 'negocios' de Supabase
NEGOCIO_ID=estudio_fotografia
SQLITE_DB_PATH=data/entorno_local.db

# --- GOOGLE CALENDAR API v3 (AGENDA REAL) ---
# Correo o ID del calendario compartido con la Service Account (ej. tunegocio@gmail.com)
GOOGLE_CALENDAR_ID=
# Ruta al archivo JSON de Service Account (ej. google_service_account.json) o el JSON completo en una linea
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_TIMEZONE=America/Bogota

# --- PUENTE BOTPRESS, MONITOR ADMIN Y NOTIFICACION AL DUENO ---
BOTPRESS_API_KEY=
# Clave requerida para consultar /api/estado y reactivar chats desde el monitor web
HUMAN_REACTIVATION_API_KEY=admin_sma_2026
OWNER_WHATSAPP_NUMBER=

# --- MOTOR GENERATIVO LOCAL LLAMA (OLLAMA) PARA AGENTE VENTAS ---
# En un computador nuevo, si LLAMA_AUTO_INSTALL=true, python main.py instala Ollama
# y descarga automaticamente el modelo Llama local sin requerir claves de API en la nube.
# LLAMA_MODEL=auto selecciona llama3.1:8b si hay GPU >= 6 GB VRAM o llama3.2:3b en CPU.
OLLAMA_HOST=http://127.0.0.1:11434
LLAMA_MODEL=llama3.1:8b
LLAMA_TIMEOUT_SECONDS=30.0
LLAMA_AUTO_INSTALL=false
# --- SERVIDOR HTTP ---
HOST=0.0.0.0
PORT=8000
