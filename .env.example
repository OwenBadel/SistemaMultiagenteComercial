# Configuracion opcional para la API puente con Botpress
# Copia este archivo como .env solo si deseas proteger el endpoint con API Key o cambiar puerto.

# Opcional: si lo dejas vacio, Botpress puede consultar sin cabecera de autenticacion (ideal para pruebas)
BOTPRESS_API_KEY=

# Servidor Web / API
HOST=0.0.0.0
PORT=8000
