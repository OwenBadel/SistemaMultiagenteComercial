# =============================================================================
# Plataforma Comercial Multi-Negocio (Rama: comercial)
# Copia este archivo como `.env` y completa tus credenciales.
# =============================================================================

# --- MOTOR IA: GOOGLE GEMINI FLASH (FACTURACION PAY-AS-YOU-GO) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# --- BASE DE DATOS MULTI-NEGOCIO (SUPABASE CLOUD O SQLITE LOCAL) ---
SUPABASE_URL=
SUPABASE_KEY=
SQLITE_DB_PATH=data/comercial_multitenant.db
# Solo respaldo si alguien llama al endpoint legacy /api/botpress/mensaje sin indicar negocio:
NEGOCIO_ID=estudio_fotografia

# --- GOOGLE CALENDAR API v3 (CADA NEGOCIO USA SU PROPIO CALENDAR_ID EN BD) ---
GOOGLE_SERVICE_ACCOUNT_JSON=google_service_account.json
GOOGLE_TIMEZONE=America/Bogota

# --- SEGURIDAD Y ACCESO AL PANEL PWA (OBLIGATORIO CAMBIAR EN PRODUCCION) ---
ADMIN_ACCESS_KEY=admin_sma_2026
SESSION_SECRET=
PUBLIC_BASE_URL=

# --- CONEXION WHATSAPP (BOTPRESS Y/O META WHATSAPP CLOUD API DIRECTA) ---
BOTPRESS_API_KEY=
WHATSAPP_VERIFY_TOKEN=sma_whatsapp_verify_2026
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
# Solo poner en true para pruebas locales sin llaves de webhook (NUNCA en produccion)
ALLOW_INSECURE_WEBHOOKS=false

# --- SERVIDOR HTTP ---
HOST=0.0.0.0
PORT=8000
